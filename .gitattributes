# Auto detect text files and perform LF normalization
* text=auto

# JS/TS files will always use LF
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf

# Images should be treated as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Fonts
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary