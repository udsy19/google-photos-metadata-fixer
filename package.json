{
  "name": "google-photos-metadata-fixer",
  "version": "0.1.0",
  "description": "Restores accurate metadata to Google Takeout exported files",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:electron\" \"npm run dev:webpack\"",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "dev:webpack": "cross-env NODE_ENV=development webpack --config webpack.config.js --watch",
    "build": "cross-env NODE_ENV=production webpack --config webpack.config.js && electron-builder",
    "build:mac": "npm run build -- --mac",
    "build:win": "npm run build -- --win",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit"
  },
  "author": "Udaya Vijay Anand",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.16.0",
    "@types/react": "^18.0.38",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "concurrently": "^8.0.1",
    "copy-webpack-plugin": "^13.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.3",
    "electron": "^27.0.0",
    "electron-builder": "^24.3.0",
    "eslint": "^8.39.0",
    "eslint-plugin-react": "^7.32.2",
    "html-webpack-plugin": "^5.5.1",
    "style-loader": "^3.3.2",
    "ts-loader": "^9.4.2",
    "typescript": "^5.0.4",
    "webpack": "^5.81.0",
    "webpack-cli": "^5.0.2"
  },
  "dependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/tar": "^6.1.13",
    "decompress": "^4.2.1",
    "electron-store": "^8.1.0",
    "extract-zip": "^2.0.1",
    "fs-extra": "^11.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tar": "^6.2.1",
    "tar-stream": "^3.1.0"
  },
  "build": {
    "appId": "com.metadata.fixer",
    "productName": "Google Photos Metadata Fixer",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
